<!DOCTYPE html>
<html lang="en" dir="ltr">
{{template "head" .}}
<body class="bg-paper text-ink font-serif antialiased">
    {{template "header" .}}
    <main class="max-w-[640px] mx-auto px-6 pt-12 pb-4">
        <div class="space-y-8">
            <div class="space-y-3">
                <div class="flex items-center gap-4">
                    <span class="font-mono text-xs uppercase tracking-[0.15em] text-muted shrink-0">Tag</span>
                    <hr class="flex-1 border-0 border-t border-rule m-0">
                </div>
                <h1 class="text-3xl font-semibold">#{{.Tag}}</h1>
                <p class="font-mono text-xs text-muted">{{.PostCount}} {{if eq .PostCount 1}}post{{else}}posts{{end}}</p>
            </div>

            {{if .Posts}}
            <ul class="divide-y divide-rule">
                {{range .Posts}}
                {{template "post-card" .}}
                {{end}}
            </ul>
            <a href="{{.BlogRoot}}" class="block font-mono text-xs text-accent pt-1">&larr; All posts</a>
            {{else}}
            <p class="font-mono text-xs text-muted">No posts with this tag yet.</p>
            <a href="{{.BlogRoot}}" class="block font-mono text-xs text-accent">&larr; All posts</a>
            {{end}}
        </div>
    </main>
    {{template "footer" .}}
</body>
</html>
