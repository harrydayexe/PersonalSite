<!DOCTYPE html>
<html lang="en" dir="ltr">
{{template "head" .}}
<body class="bg-paper text-ink font-serif antialiased">
    {{template "header" .}}
    <main class="max-w-[640px] mx-auto px-6 pt-12 pb-4">
        <div class="space-y-8">
            <div class="space-y-3">
                <div class="flex items-center gap-4">
                    <h1 class="font-mono text-xs uppercase tracking-[0.15em] text-muted shrink-0">Tags</h1>
                    <hr class="flex-1 border-0 border-t border-rule m-0">
                </div>
                <p class="font-mono text-xs text-muted">{{.TotalTags}} {{if eq .TotalTags 1}}tag{{else}}tags{{end}}</p>
            </div>

            {{if .Tags}}
            <ul class="divide-y divide-rule">
                {{range .Tags}}
                <li>
                    <a href="{{$.BlogRoot}}tags/{{.Name}}" class="grid grid-cols-[1fr_auto] items-baseline gap-6 py-3.5 group">
                        <span class="font-mono text-xs uppercase tracking-[0.15em] text-ink group-hover:text-accent transition-colors duration-150">#{{.Name}}</span>
                        <span class="font-mono text-xs text-muted">{{.PostCount}} {{if eq .PostCount 1}}post{{else}}posts{{end}}</span>
                    </a>
                </li>
                {{end}}
            </ul>
            <a href="{{.BlogRoot}}" class="block font-mono text-xs text-accent pt-1">&larr; All posts</a>
            {{else}}
            <p class="font-mono text-xs text-muted">No tags yet.</p>
            <a href="{{.BlogRoot}}" class="block font-mono text-xs text-accent">&larr; All posts</a>
            {{end}}
        </div>
    </main>
    {{template "footer" .}}
</body>
</html>
