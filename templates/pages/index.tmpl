<!DOCTYPE html>
<html lang="en" dir="ltr">
{{template "head" .}}
<body class="bg-paper text-ink font-serif antialiased">
    {{template "header" .}}
    <main class="max-w-[640px] mx-auto px-6 pt-12 pb-4">
        <div class="space-y-8">
            <div class="flex items-center gap-4">
                <h1 class="font-mono text-xs uppercase tracking-[0.15em] text-muted shrink-0">Writing</h1>
                <hr class="flex-1 border-0 border-t border-rule m-0">
            </div>
            <p class="font-mono text-xs text-muted -mt-4">{{.TotalPosts}} {{if eq .TotalPosts 1}}post{{else}}posts{{end}}</p>

            {{if .Posts}}
            <ul class="divide-y divide-rule">
                {{range .Posts}}
                {{template "post-card" .}}
                {{end}}
            </ul>
            {{else}}
            <p class="font-mono text-xs text-muted">No posts yet. Check back soon.</p>
            {{end}}
        </div>
    </main>
    {{template "footer" .}}
</body>
</html>
