<!DOCTYPE html>
<html lang="en" dir="ltr">
{{template "head" .}}
<body class="bg-paper text-ink font-serif antialiased">
    {{template "header" .}}
    <main class="max-w-[640px] mx-auto px-6 pt-12 pb-4">
        <article class="space-y-8">
            <header class="space-y-4">
                <div class="flex items-center gap-3">
                    <time datetime="{{.Post.ShortDate}}" class="font-mono text-xs uppercase tracking-[0.15em] text-muted">{{.Post.FormattedDate}}</time>
                    {{if .Post.ReadingTimeMinutes}}
                    <span class="font-mono text-xs text-muted">&middot; {{.Post.ReadingTimeMinutes}} min read</span>
                    {{end}}
                </div>
                <h1 class="text-3xl font-semibold leading-tight">{{.Post.Title}}</h1>
                {{if .Post.Description}}
                <p class="text-xl text-muted leading-[1.55]">{{.Post.Description}}</p>
                {{end}}
                {{if .Post.Tags}}
                <div class="flex flex-wrap gap-2">
                    {{range .Post.Tags}}
                    <a href="{{$.BlogRoot}}tags/{{.}}" class="font-mono text-xs uppercase tracking-[0.1em] border border-rule text-muted px-2 py-0.5 rounded-full hover:border-accent hover:text-accent transition-colors">#{{.}}</a>
                    {{end}}
                </div>
                {{end}}
            </header>

            <hr class="border-0 border-t border-rule">

            <div class="post-content">
                {{.Post.HTMLContent}}
            </div>

            <div class="pt-4 border-t border-rule">
                <a href="{{.BlogRoot}}" class="font-mono text-xs text-accent hover:border-b hover:border-accent transition-colors duration-150">&larr; All posts</a>
            </div>
        </article>
    </main>
    {{template "footer" .}}
</body>
</html>
