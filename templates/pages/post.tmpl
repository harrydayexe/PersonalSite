<!DOCTYPE html>
<html lang="en" dir="ltr" class="h-full">
{{template "head" .}}
<body class="min-h-full flex flex-col bg-white text-gray-900 font-sans">
    {{template "header" .}}
    <main class="flex-1 max-w-[900px] w-full mx-auto px-5 py-10">
        <article>
            <header class="border-b border-gray-100 pb-6 mb-2">
                <p class="text-sm text-gray-400 mb-2">
                    <time datetime="{{.Post.ShortDate}}">{{.Post.FormattedDate}}</time>
                </p>
                <h1 class="font-mono font-bold text-3xl sm:text-4xl text-gray-900 mb-3">{{.Post.Title}}</h1>
                {{if .Post.Description}}
                <p class="text-gray-500 text-lg mb-4">{{.Post.Description}}</p>
                {{end}}
                {{if .Post.Tags}}
                <div class="flex flex-wrap gap-2">
                    {{range .Post.Tags}}
                    <a href="{{$.BlogRoot}}tags/{{.}}" class="inline-block border-2 border-accent text-accent text-sm px-3 py-0.5 rounded-full hover:bg-accent hover:text-white transition-colors">#{{.}}</a>
                    {{end}}
                </div>
                {{end}}
            </header>

            <div class="prose prose-lg max-w-none mt-8 prose-a:text-accent prose-headings:font-mono prose-code:text-red-600 prose-code:before:content-none prose-code:after:content-none">
                {{.Post.HTMLContent}}
            </div>

            <div class="mt-10 pt-6 border-t border-gray-100">
                <a href="{{.BlogRoot}}" class="text-accent font-medium hover:underline">&larr; Back to Blog</a>
            </div>
        </article>
    </main>
    {{template "footer" .}}
</body>
</html>
