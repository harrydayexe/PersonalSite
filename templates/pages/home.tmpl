<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <title>Harry Day</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Harry Day — software engineer based in Manchester.">
    <meta name="robots" content="index, follow">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="language" content="English">
    <meta name="author" content="Harry Day">
    <meta name="theme-color" content="#FF9400">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Open Graph -->
    <meta property="og:site_name" content="Harry Day">
    <meta property="og:type" content="profile">
    <meta property="og:title" content="Harry Day">
    <meta property="og:url" content="https://harryday.xyz">
    <meta property="og:image" content="https://harryday.xyz/images/socialimage.png">
    <meta property="og:description" content="Harry Day — software engineer based in Manchester.">
    <meta property="profile:first_name" content="Harry">
    <meta property="profile:last_name" content="Day">
    <meta property="profile:username" content="harrydayexe">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@harrydayexe">
    <meta name="twitter:title" content="Harry Day">
    <meta name="twitter:description" content="Harry Day — software engineer based in Manchester.">
    <meta name="twitter:image" content="https://harryday.xyz/images/socialimage.png">

    <link rel="stylesheet" href="/styles/tailwind.css">
    {{if .DevMode}}
    <script>
        const es = new EventSource("/reload");
        es.onerror = () => { es.close(); setTimeout(() => location.reload(), 1500); };
    </script>
    {{end}}
</head>
<body class="bg-paper text-ink font-serif antialiased">
<div class="mx-auto max-w-[640px] md:max-w-5xl px-6 pt-24 pb-20">
<div class="flex flex-col space-y-6 md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16 md:space-y-0 md:items-start">

    <!-- Left col, top: identity + intro + in-page nav (sticky on desktop) -->
    <div class="md:col-start-1 md:row-start-1 md:sticky md:top-12 md:self-start space-y-12">

        <header>
            <h1 class="text-3xl font-semibold">Harry Day</h1>
            <p class="font-mono text-xs uppercase tracking-[0.15em] text-muted mt-1">
                Software engineer &middot; London, UK
            </p>
        </header>

        <section class="space-y-5 text-xl leading-[1.55]">
            <p>I build software, mostly in Go, and currently work at <a href="https://novlr.org" class="text-accent hover:border-b hover:border-accent transition-[border-color] duration-150" target="_blank" rel="noopener noreferrer">Novlr</a>, an online platform for writers. Before that I was on the platform team at UBS, building infrastructure for asset management at scale.</p>
        </section>

        <nav class="hidden md:block space-y-2.5">
            <a href="#" class="block font-mono text-xs text-muted hover:text-accent transition-colors duration-150">Writing &rarr;</a>
            <a href="#selected-work" class="block font-mono text-xs text-muted hover:text-accent transition-colors duration-150">Selected work &rarr;</a>
            <a href="#experience" class="block font-mono text-xs text-muted hover:text-accent transition-colors duration-150">Experience &rarr;</a>
        </nav>

        <div class="hidden md:block space-y-12">
            <section class="space-y-4">
                {{template "section-label" "Elsewhere"}}
                <ul class="space-y-2.5">
                    <li>
                        <a href="https://github.com/harrydayexe"
                           class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                           target="_blank" rel="noopener noreferrer">github.com/harrydayexe</a>
                    </li>
                    <li>
                        <a href="https://linkedin.com/in/harrydayexe"
                           class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                           target="_blank" rel="noopener noreferrer">linkedin.com/in/harrydayexe</a>
                    </li>
                    <li>
                        <a href="https://twitter.com/harrydayexe"
                           class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                           target="_blank" rel="noopener noreferrer">x.com/harrydayexe</a>
                    </li>
                </ul>
            </section>

            <footer class="font-mono text-xs uppercase tracking-[0.15em] text-muted">
                &copy; {{.Year}} Harry Day
            </footer>
        </div>

    </div>

    <!-- Right col: Writing, Selected work, Experience -->
    <div class="md:col-start-2 md:row-start-1 space-y-16 md:pt-10">

        <section id="writing" class="space-y-4 scroll-mt-12">
            <div class="flex items-center gap-4">
                <a href="{{.BlogRoot}}" class="font-mono text-xs uppercase tracking-[0.15em] text-muted hover:text-accent transition-colors duration-150 shrink-0">Writing</a>
                <hr class="flex-1 border-0 border-t border-rule m-0">
            </div>
            {{if .Posts}}
            <ul class="divide-y divide-rule">
                {{range $i, $post := .Posts}}
                <li class="{{if ge $i 5}}hidden md:block{{end}}">
                    <a href="{{$.BlogRoot}}posts/{{$post.Slug}}"
                       class="grid grid-cols-[6rem_1fr] gap-6 py-3.5 group">
                        <time datetime="{{$post.ShortDate}}"
                              class="font-mono text-xs text-muted pt-px shrink-0">{{$post.ShortDate}}</time>
                        <span class="text-ink group-hover:text-accent transition-colors duration-150">{{$post.Title}}</span>
                    </a>
                </li>
                {{end}}
            </ul>
            {{else}}
            <p class="text-muted text-sm font-mono">No posts yet.</p>
            {{end}}
            <a href="{{.BlogRoot}}" class="block font-mono text-xs text-muted hover:text-accent transition-colors duration-150 pt-1">All posts &rarr;</a>
        </section>

        <section id="selected-work" class="space-y-4 scroll-mt-12">
            {{template "section-label" "Selected work"}}
            <div class="space-y-7 text-base leading-[1.65]">
                <div>
                    <p><span class="font-semibold">Omni</span> &mdash; a platform for CS students to publish and showcase personal projects, designed to go from zero to a million users without changing the architecture. Built in Go with HTMX on the front-end, deployed to a self-hosted Kubernetes cluster.</p>
                    <p class="font-mono text-xs uppercase tracking-[0.12em] text-muted mt-2">Go &middot; HTMX &middot; Kubernetes &mdash; 2024</p>
                </div>
                <div>
                    <p><span class="font-semibold">SongLinkr</span> &mdash; an iOS utility that converts music links between streaming platforms so you can open them wherever you actually listen. Built natively in Swift.</p>
                    <p class="font-mono text-xs uppercase tracking-[0.12em] text-muted mt-2">Swift &middot; SwiftUI &mdash; 2021</p>
                </div>
                <div>
                    <p><span class="font-semibold">Gentle Ghosts</span> &mdash; a generative art collection of 5,000 unique pixel-art ghosts, each built from a randomised set of traits. The generation pipeline was written in Python; the downscaling in Node.</p>
                    <p class="font-mono text-xs uppercase tracking-[0.12em] text-muted mt-2">Python &middot; Node &mdash; 2022</p>
                </div>
            </div>
        </section>

        <section id="experience" class="space-y-4 scroll-mt-12">
            {{template "section-label" "Experience"}}
            <div class="space-y-7 text-base leading-[1.65]">
                <div>
                    <p><span class="font-semibold">Novlr</span> &mdash; Software Engineer. Building and maintaining an online writing platform used by authors worldwide.</p>
                    <p class="font-mono text-xs uppercase tracking-[0.12em] text-muted mt-2">2024 &ndash; Present</p>
                </div>
                <div>
                    <p><span class="font-semibold">UBS</span> &mdash; Platform Engineer. Part of the platform team building infrastructure for asset management at scale.</p>
                    <p class="font-mono text-xs uppercase tracking-[0.12em] text-muted mt-2">2023 &ndash; 2024</p>
                </div>
                <div>
                    <p><span class="font-semibold">University of Manchester</span> &mdash; MEng Computer Science.</p>
                    <p class="font-mono text-xs uppercase tracking-[0.12em] text-muted mt-2">2021 &ndash; 2025</p>
                </div>
            </div>
        </section>

    </div>

    <!-- Mobile-only: elsewhere + footer at bottom of page -->
    <div class="md:hidden space-y-10">
        <section class="space-y-4">
            {{template "section-label" "Elsewhere"}}
            <ul class="space-y-2.5">
                <li>
                    <a href="https://github.com/harrydayexe"
                       class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                       target="_blank" rel="noopener noreferrer">github.com/harrydayexe</a>
                </li>
                <li>
                    <a href="https://linkedin.com/in/harrydayexe"
                       class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                       target="_blank" rel="noopener noreferrer">linkedin.com/in/harrydayexe</a>
                </li>
                <li>
                    <a href="https://twitter.com/harrydayexe"
                       class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                       target="_blank" rel="noopener noreferrer">x.com/harrydayexe</a>
                </li>
            </ul>
        </section>

        <footer class="font-mono text-xs uppercase tracking-[0.15em] text-muted">
            &copy; {{.Year}} Harry Day
        </footer>
    </div>

</div>
</div>
</body>
</html>

{{define "section-label"}}
<div class="flex items-center gap-4">
    <h2 class="font-mono text-xs uppercase tracking-[0.15em] text-muted shrink-0">{{.}}</h2>
    <hr class="flex-1 border-0 border-t border-rule m-0">
</div>
{{end}}
