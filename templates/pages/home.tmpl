<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <title>Harry Day</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Harry Day — software engineer based in Manchester.">
    <meta name="robots" content="index, follow">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="language" content="English">
    <meta name="author" content="Harry Day">
    <meta name="theme-color" content="#FF9400">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Open Graph -->
    <meta property="og:site_name" content="Harry Day">
    <meta property="og:type" content="profile">
    <meta property="og:title" content="Harry Day">
    <meta property="og:url" content="https://harryday.xyz">
    <meta property="og:image" content="https://harryday.xyz/images/socialimage.png">
    <meta property="og:description" content="Harry Day — software engineer based in Manchester.">
    <meta property="profile:first_name" content="Harry">
    <meta property="profile:last_name" content="Day">
    <meta property="profile:username" content="harrydayexe">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@harrydayexe">
    <meta name="twitter:title" content="Harry Day">
    <meta name="twitter:description" content="Harry Day — software engineer based in Manchester.">
    <meta name="twitter:image" content="https://harryday.xyz/images/socialimage.png">

    <link rel="stylesheet" href="/styles/tailwind.css">
</head>
<body class="bg-paper text-ink font-serif antialiased">
<div class="mx-auto max-w-[640px] px-6 pt-24 pb-20 space-y-16">

    <!-- Header: name + quiet subtitle. Not the loudest thing on the page. -->
    <header>
        <h1 class="text-base font-semibold">Harry Day</h1>
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted mt-1">
            Software engineer &middot; Manchester, UK
        </p>
    </header>

    <!-- Intro: the largest text on the page. The page is about what's said. -->
    <section class="space-y-5 text-[1.3rem] leading-[1.55]">
        <p>I build software, mostly in Go, and currently work at <a href="https://novlr.org" class="text-accent hover:border-b hover:border-accent transition-[border-color] duration-150" target="_blank" rel="noopener noreferrer">Novlr</a>, an online platform for writers. Before that I was on the platform team at UBS, building infrastructure for asset management at scale.</p>
        <p>This site is a place for writing. Projects and experience exist here too, but they&rsquo;re not the main event. If something I&rsquo;ve written is useful or prompts a question, <a href="mailto:contact@harryday.xyz" class="text-accent hover:border-b hover:border-accent transition-[border-color] duration-150">I&rsquo;d like to hear from you</a>.</p>
    </section>

    <!-- Now: what I'm currently working on, datestamped -->
    <section class="space-y-4">
        {{template "section-label" "Now"}}
        <div class="space-y-3">
            <p class="font-mono text-xs text-muted">April 2026</p>
            <p class="text-[1.05rem] leading-[1.65]">Currently finishing my dissertation, rebuilding this site, and spending spare cycles reading about distributed systems. Somewhere in there I&rsquo;m also trying to get better at cooking.</p>
        </div>
    </section>

    <!-- Writing: the most prominent section. Date left, title right. -->
    <section class="space-y-4">
        {{template "section-label" "Writing"}}
        {{if .Posts}}
        <ul class="divide-y divide-rule">
            {{range .Posts}}
            <li>
                <a href="{{$.BlogRoot}}posts/{{.Slug}}"
                   class="grid grid-cols-[6rem_1fr] gap-6 py-3.5 group">
                    <time datetime="{{.ShortDate}}"
                          class="font-mono text-xs text-muted pt-px shrink-0">{{.ShortDate}}</time>
                    <span class="text-ink group-hover:text-accent transition-colors duration-150">{{.Title}}</span>
                </a>
            </li>
            {{end}}
        </ul>
        {{else}}
        <p class="text-muted text-sm font-mono">No posts yet.</p>
        {{end}}
    </section>

    <!-- Selected work: inline prose. No cards, no icons, no screenshots. -->
    <section class="space-y-4">
        {{template "section-label" "Selected work"}}
        <div class="space-y-7 text-[1.05rem] leading-[1.65]">
            <div>
                <p><span class="font-semibold">Omni</span> &mdash; a platform for CS students to publish and showcase personal projects, designed to go from zero to a million users without changing the architecture. Built in Go with HTMX on the front-end, deployed to a self-hosted Kubernetes cluster.</p>
                <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted mt-2">Go &middot; HTMX &middot; Kubernetes &mdash; 2024</p>
            </div>
            <div>
                <p><span class="font-semibold">SongLinkr</span> &mdash; an iOS utility that converts music links between streaming platforms so you can open them wherever you actually listen. Built natively in Swift.</p>
                <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted mt-2">Swift &middot; SwiftUI &mdash; 2021</p>
            </div>
            <div>
                <p><span class="font-semibold">Gentle Ghosts</span> &mdash; a generative art collection of 5,000 unique pixel-art ghosts, each built from a randomised set of traits. The generation pipeline was written in Python; the downscaling in Node.</p>
                <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted mt-2">Python &middot; Node &mdash; 2022</p>
            </div>
        </div>
    </section>

    <!-- Elsewhere: text links only, no icons -->
    <section class="space-y-4">
        {{template "section-label" "Elsewhere"}}
        <ul class="space-y-2.5">
            <li>
                <a href="https://github.com/harrydayexe"
                   class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                   target="_blank" rel="noopener noreferrer">github.com/harrydayexe</a>
            </li>
            <li>
                <a href="https://linkedin.com/in/harrydayexe"
                   class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                   target="_blank" rel="noopener noreferrer">linkedin.com/in/harrydayexe</a>
            </li>
            <li>
                <a href="https://twitter.com/harrydayexe"
                   class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150"
                   target="_blank" rel="noopener noreferrer">x.com/harrydayexe</a>
            </li>
            <li>
                <a href="mailto:contact@harryday.xyz"
                   class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150">contact@harryday.xyz</a>
            </li>
        </ul>
    </section>

    <!-- Footer: minimal copyright line -->
    <footer class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted">
        &copy; {{.Year}} Harry Day
    </footer>

</div>
</body>
</html>

{{define "section-label"}}
<div class="flex items-center gap-4">
    <h2 class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted shrink-0">{{.}}</h2>
    <hr class="flex-1 border-0 border-t border-rule m-0">
</div>
{{end}}
