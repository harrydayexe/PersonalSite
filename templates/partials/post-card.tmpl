{{define "post-card"}}
<article class="border-b border-gray-100 py-7 last:border-0">
    <p class="text-sm text-gray-400 mb-2">
        <time datetime="{{.ShortDate}}">{{.FormattedDate}}</time>
    </p>
    <h3 class="font-mono font-bold text-xl mb-2">
        <a href="{{.BlogRoot}}posts/{{.Slug}}" class="text-gray-900 hover:text-accent transition-colors">{{.Title}}</a>
    </h3>
    {{if .Description}}
    <p class="text-gray-600 mb-3">{{.Description}}</p>
    {{end}}
    {{if .Tags}}
    <div class="flex flex-wrap gap-2 mt-3">
        {{range .Tags}}
        <a href="{{$.BlogRoot}}tags/{{.}}" class="inline-block border-2 border-accent text-accent text-sm px-3 py-0.5 rounded-full hover:bg-accent hover:text-white transition-colors">#{{.}}</a>
        {{end}}
    </div>
    {{end}}
</article>
{{end}}
