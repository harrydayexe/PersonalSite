{{define "post-card"}}
<div class="py-3.5 group">
    <a href="{{.BlogRoot}}posts/{{.Slug}}" class="block">
        <div class="flex gap-6 items-start">
            <time datetime="{{.ShortDate}}" class="font-mono text-xs text-muted shrink-0 w-24 pt-0.5">{{.ShortDate}}</time>
            <div>
                <span class="text-base text-ink group-hover:text-accent transition-colors duration-150">{{.Title}}</span>
                {{if .Description}}
                <p class="text-base text-muted leading-[1.55] mt-1">{{.Description}}</p>
                {{end}}
            </div>
        </div>
    </a>
    {{if .Tags}}
    <div class="flex flex-wrap gap-2 mt-2 pl-[7.5rem]">
        {{range .Tags}}
        <a href="{{$.BlogRoot}}tags/{{.}}" class="font-mono text-xs uppercase tracking-[0.1em] border border-rule text-muted px-2 py-0.5 rounded-full hover:border-accent hover:text-accent transition-colors">#{{.}}</a>
        {{end}}
    </div>
    {{end}}
</div>
{{end}}
