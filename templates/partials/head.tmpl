{{define "head"}}
<head>
    <meta charset="utf-8">
    <title>{{if .PageTitle}}{{.PageTitle}} — {{end}}{{.SiteTitle}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{if .Description}}{{.Description}}{{else}}Harry Day's blog — software, projects, and ideas.{{end}}">
    <meta name="robots" content="index, follow">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="language" content="English">
    <meta name="author" content="Harry Day">
    <meta name="theme-color" content="#FF9400">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Open Graph -->
    <meta property="og:site_name" content="Harry Day{}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{if .PageTitle}}{{.PageTitle}} — {{end}}{{.SiteTitle}}">
    <meta property="og:description" content="{{if .Description}}{{.Description}}{{else}}Harry Day's blog — software, projects, and ideas.{{end}}">
    <meta property="og:url" content="https://harryday.xyz{{.BlogRoot}}">
    <meta property="og:image" content="https://harryday.xyz/images/socialimage.png">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@harrydayexe">
    <meta name="twitter:title" content="{{if .PageTitle}}{{.PageTitle}} — {{end}}{{.SiteTitle}}">
    <meta name="twitter:description" content="{{if .Description}}{{.Description}}{{else}}Harry Day's blog — software, projects, and ideas.{{end}}">
    <meta name="twitter:image" content="https://harryday.xyz/images/socialimage.png">

    <meta name="color-scheme" content="light">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: '#FF9400',
                    },
                    fontFamily: {
                        mono: ['ui-monospace', 'Menlo', 'Monaco', '"Cascadia Mono"', '"Segoe UI Mono"', '"Roboto Mono"', '"Oxygen Mono"', '"Ubuntu Monospace"', '"Source Code Pro"', '"Fira Mono"', '"Droid Sans Mono"', '"Courier New"', 'monospace'],
                    },
                },
            },
        }
    </script>
    <style>
        ::selection { background: #FF9400; color: #fff; }
        ::-moz-selection { background: #FF9400; color: #fff; }
    </style>
</head>
{{end}}
