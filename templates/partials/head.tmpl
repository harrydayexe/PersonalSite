{{define "head"}}
{{/* Page-type discrimination. Paths are clean URLs: {BlogRoot}, {BlogRoot}posts/{slug},
     {BlogRoot}tags and {BlogRoot}tags/{tag}. */}}
{{$site := .Custom.siteURL}}
{{$canonical := printf "%s%s" .Custom.siteURL .Path}}
{{$personID := printf "%s/#person" .Custom.siteURL}}
{{$websiteID := printf "%s/#website" .Custom.siteURL}}
{{$blogURL := printf "%s%s" .Custom.siteURL .BlogRoot}}
{{$blogID := printf "%s%s#blog" .Custom.siteURL .BlogRoot}}
{{$tagsURL := printf "%s%stags" .Custom.siteURL .BlogRoot}}
{{$isPost := hasPrefix .Path (printf "%sposts/" .BlogRoot)}}
{{$isTag := hasPrefix .Path (printf "%stags/" .BlogRoot)}}
{{$isTagsIndex := eq .Path (printf "%stags" .BlogRoot)}}

<head>
    <meta charset="utf-8">
    <title>{{if .PageTitle}}{{.PageTitle}} — {{end}}{{.SiteTitle}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="{{if .Description}}{{.Description}}{{else}}Harry Day's blog — software, projects, and ideas.{{end}}">
    <meta name="robots" content="index, follow">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="language" content="English">
    <meta name="author" content="Harry Day">
    <meta name="theme-color" content="#FF9400">

    <link rel="canonical" href="{{.Custom.siteURL}}{{.Path}}">

    {{/* Feed autodiscovery. The blog-root paths are canonical; /rss.xml and
         /atom.xml exist only as redirects for readers that probe the site root. */}}
    {{if .FeedsEnabled}}
    <link rel="alternate" type="application/rss+xml" title="Harry Day — RSS" href="{{.BlogRoot}}rss.xml">
    <link rel="alternate" type="application/atom+xml" title="Harry Day — Atom" href="{{.BlogRoot}}atom.xml">
    {{end}}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Open Graph -->
    <meta property="og:site_name" content="Harry Day">
    {{if $isPost}}
    <meta property="og:type" content="article">
    <meta property="article:published_time" content="{{isoDate .Post.Date}}">
    {{if .Post.HasLastEdited}}
    <meta property="article:modified_time" content="{{isoDate .Post.LastEdited}}">
    {{end}}
    <meta property="article:author" content="Harry Day">
    {{range .Post.Tags}}<meta property="article:tag" content="{{.}}">
    {{end}}
    {{else}}
    <meta property="og:type" content="website">
    {{end}}
    <meta property="og:title" content="{{if .PageTitle}}{{.PageTitle}} — {{end}}{{.SiteTitle}}">
    <meta property="og:description"
        content="{{if .Description}}{{.Description}}{{else}}Harry Day's blog — software, projects, and ideas.{{end}}">
    <meta property="og:url" content="{{.Custom.siteURL}}{{.Path}}">
    <meta property="og:image" content="{{.Custom.siteURL}}/images/socialimage.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Harry Day — software engineer">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@harrydayexe">
    <meta name="twitter:title" content="{{if .PageTitle}}{{.PageTitle}} — {{end}}{{.SiteTitle}}">
    <meta name="twitter:description"
        content="{{if .Description}}{{.Description}}{{else}}Harry Day's blog — software, projects, and ideas.{{end}}">
    <meta name="twitter:image" content="{{.Custom.siteURL}}/images/socialimage.png">
    <meta name="twitter:image:alt" content="Harry Day — software engineer">

    <!-- Structured data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {{template "schema-person" $site}},
            {{template "schema-website" $site}},
            {{if $isPost}}
            {
                "@type": "BlogPosting",
                "@id": {{printf "%s#blogposting" $canonical}},
                "url": {{$canonical}},
                "mainEntityOfPage": {"@id": {{printf "%s#webpage" $canonical}}},
                "headline": {{.Post.Title}},
                "description": {{.Post.Description}},
                "image": {{printf "%s/images/socialimage.png" $site}},
                "datePublished": {{isoDate .Post.Date}},
                {{if and .Post.HasLastEdited (ne (isoDate .Post.LastEdited) (isoDate .Post.Date))}}"dateModified": {{isoDate .Post.LastEdited}},
                {{end}}{{if .Post.Tags}}"keywords": [{{range $i, $tag := .Post.Tags}}{{if $i}}, {{end}}{{$tag}}{{end}}],
                {{end}}{{with .Post.ReadingTimeMinutes}}"timeRequired": {{printf "PT%dM" .}},
                {{end}}{{with wordCount .Post.RawContent}}"wordCount": {{.}},
                {{end}}"inLanguage": "en-GB",
                "isPartOf": {"@id": {{$blogID}}},
                "author": {"@id": {{$personID}}},
                "publisher": {"@id": {{$personID}}}
            },
            {
                "@type": "WebPage",
                "@id": {{printf "%s#webpage" $canonical}},
                "url": {{$canonical}},
                "name": {{.Post.Title}},
                "description": {{.Post.Description}},
                "inLanguage": "en-GB",
                "isPartOf": {"@id": {{$websiteID}}},
                "breadcrumb": {"@id": {{printf "%s#breadcrumb" $canonical}}}
            },
            {
                "@type": "BreadcrumbList",
                "@id": {{printf "%s#breadcrumb" $canonical}},
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{printf "%s/" $site}}},
                    {"@type": "ListItem", "position": 2, "name": "Writing", "item": {{$blogURL}}},
                    {"@type": "ListItem", "position": 3, "name": {{.Post.Title}}, "item": {{$canonical}}}
                ]
            }
            {{else if $isTag}}
            {
                "@type": "CollectionPage",
                "@id": {{printf "%s#webpage" $canonical}},
                "url": {{$canonical}},
                "name": {{printf "Posts tagged #%s" .Tag}},
                "description": {{printf "Every post on Harry Day's blog tagged #%s." .Tag}},
                "inLanguage": "en-GB",
                "isPartOf": {"@id": {{$websiteID}}},
                "breadcrumb": {"@id": {{printf "%s#breadcrumb" $canonical}}},
                "mainEntity": {"@id": {{printf "%s#itemlist" $canonical}}}
            },
            {
                "@type": "ItemList",
                "@id": {{printf "%s#itemlist" $canonical}},
                "numberOfItems": {{.PostCount}},
                "itemListElement": [{{range $i, $post := .Posts}}{{if $i}},{{end}}
                    {"@type": "ListItem", "position": {{inc $i}}, "name": {{$post.Title}}, "url": {{printf "%s%sposts/%s" $site $.BlogRoot $post.Slug}}}{{end}}
                ]
            },
            {
                "@type": "BreadcrumbList",
                "@id": {{printf "%s#breadcrumb" $canonical}},
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{printf "%s/" $site}}},
                    {"@type": "ListItem", "position": 2, "name": "Tags", "item": {{$tagsURL}}},
                    {"@type": "ListItem", "position": 3, "name": {{printf "#%s" .Tag}}, "item": {{$canonical}}}
                ]
            }
            {{else if $isTagsIndex}}
            {
                "@type": "CollectionPage",
                "@id": {{printf "%s#webpage" $canonical}},
                "url": {{$canonical}},
                "name": "Tags",
                "description": "Every tag used across Harry Day's writing.",
                "inLanguage": "en-GB",
                "isPartOf": {"@id": {{$websiteID}}},
                "breadcrumb": {"@id": {{printf "%s#breadcrumb" $canonical}}},
                "mainEntity": {"@id": {{printf "%s#itemlist" $canonical}}}
            },
            {
                "@type": "ItemList",
                "@id": {{printf "%s#itemlist" $canonical}},
                "numberOfItems": {{.TotalTags}},
                "itemListElement": [{{range $i, $tag := .Tags}}{{if $i}},{{end}}
                    {"@type": "ListItem", "position": {{inc $i}}, "name": {{printf "#%s" $tag.Name}}, "url": {{printf "%s%stags/%s" $site $.BlogRoot $tag.Name}}}{{end}}
                ]
            },
            {
                "@type": "BreadcrumbList",
                "@id": {{printf "%s#breadcrumb" $canonical}},
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{printf "%s/" $site}}},
                    {"@type": "ListItem", "position": 2, "name": "Tags", "item": {{$tagsURL}}}
                ]
            }
            {{else}}
            {
                "@type": "Blog",
                "@id": {{$blogID}},
                "url": {{$blogURL}},
                "name": "Writing",
                {{/* Not .Description: the generator supplies "Recent blog posts" for the
                     index, which is too thin to be worth indexing. */}}
                "description": "Harry Day's blog — software, projects, and ideas.",
                "inLanguage": "en-GB",
                "isPartOf": {"@id": {{$websiteID}}},
                "author": {"@id": {{$personID}}},
                "publisher": {"@id": {{$personID}}}{{if .Posts}},
                "blogPost": [{{range $i, $post := .Posts}}{{if $i}},{{end}}
                    {
                        "@type": "BlogPosting",
                        "@id": {{printf "%s%sposts/%s#blogposting" $site $.BlogRoot $post.Slug}},
                        "headline": {{$post.Title}},
                        "url": {{printf "%s%sposts/%s" $site $.BlogRoot $post.Slug}},
                        "datePublished": {{isoDate $post.Date}}
                    }{{end}}
                ]{{end}}
            },
            {
                "@type": "CollectionPage",
                "@id": {{printf "%s#webpage" $canonical}},
                "url": {{$canonical}},
                "name": "Writing",
                "inLanguage": "en-GB",
                "isPartOf": {"@id": {{$websiteID}}},
                "breadcrumb": {"@id": {{printf "%s#breadcrumb" $canonical}}},
                "mainEntity": {"@id": {{$blogID}}}
            },
            {
                "@type": "BreadcrumbList",
                "@id": {{printf "%s#breadcrumb" $canonical}},
                "itemListElement": [
                    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{printf "%s/" $site}}},
                    {"@type": "ListItem", "position": 2, "name": "Writing", "item": {{$blogURL}}}
                ]
            }
            {{end}}
        ]
    }
    </script>

    <link rel="stylesheet" href="/styles/tailwind.css">
    {{if eq .Environment "local"}}
    <script>
        const es = new EventSource("/reload");
        es.onerror = () => {es.close(); setTimeout(() => location.reload(), 1500);};
    </script>
    {{end}}
</head>
{{end}}
