{{define "content"}}
<h1 class="font-mono font-bold text-4xl text-gray-900 mb-2">#{{.Tag}}</h1>
<p class="text-gray-400 mb-8">{{.PostCount}} {{if eq .PostCount 1}}post{{else}}posts{{end}}</p>

{{if .Posts}}
<div>
    {{range .Posts}}
    {{template "post-card" .}}
    {{end}}
</div>
<div class="mt-8 pt-6 border-t border-gray-100">
    <a href="{{.BlogRoot}}" class="text-accent font-medium hover:underline">&larr; Back to Blog</a>
</div>
{{else}}
<div class="text-center py-16 text-gray-400">
    <p>No posts with this tag yet.</p>
</div>
<div class="mt-4">
    <a href="{{.BlogRoot}}" class="text-accent font-medium hover:underline">&larr; Back to Blog</a>
</div>
{{end}}
{{end}}
