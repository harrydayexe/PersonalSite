{{define "content"}}
<h1 class="font-mono font-bold text-4xl text-gray-900 mb-2">Blog</h1>
<p class="text-gray-400 mb-8">{{.TotalPosts}} {{if eq .TotalPosts 1}}post{{else}}posts{{end}} published</p>

{{if .Posts}}
<div>
    {{range .Posts}}
    {{template "post-card" .}}
    {{end}}
</div>
{{else}}
<div class="text-center py-16 text-gray-400">
    <p>No posts yet. Check back soon.</p>
</div>
{{end}}
{{end}}
